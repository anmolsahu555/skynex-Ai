rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Entity Validation Blueprints (Matching firebase-blueprint.json)
    function isValidUserPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'roleLabel', 'isDemo', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'roleLabel', 'isDemo', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.roleLabel is string
        && data.roleLabel.size() >= 1
        && data.roleLabel.size() <= 64
        && (data.roleLabel == 'Brand Compliance Manager' || data.roleLabel == 'Evaluator Demo Account' || data.roleLabel == 'Content Reviewer')
        && data.isDemo is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.createdAt is timestamp;
    }

    function isValidDemoAuditLog(data) {
      return data.keys().hasAll(['uid', 'action', 'brandId', 'createdAt'])
        && data.keys().hasOnly(['uid', 'action', 'brandId', 'createdAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.action is string
        && data.action.size() >= 1
        && data.action.size() <= 120
        && data.brandId is string
        && data.brandId.size() >= 1
        && data.brandId.size() <= 64
        && data.brandId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.createdAt is timestamp;
    }

    // 4. Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserPublicProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserPublicProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().isDemo == existing().isDemo
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update Display Profile
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        );

      allow delete: if false;

      // Subcollection: /users/{userId}/private/{docId} (PII Split Collection)
      match /private/{docId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if false;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == userId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update, delete: if false;
      }
    }

    // 5. Collection: /demo_sandbox_logs/{logId} (Isolated Demo Sandbox)
    match /demo_sandbox_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && existing().uid == request.auth.uid;
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidDemoAuditLog(incoming())
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
